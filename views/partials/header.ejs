<script type="module" src="main.js"></script>
<script>
  function showDownload() {
    // localstorage.keys().then(keys => {
    //   let found = keys.find(k => k.indexOf('1-1000') > -1);
    //   if (found) {
    //     $('#download').hide();
    //   } else {
    //     $('#download').show();
    //   }
    // });
  }
  $(window).on("load", () => {
    let hastoken=<%=hastoken%>;
    if (hastoken) {
      $('#authorize').hide();
      $('#logoff').show();
      showDownload();
    } else {
      $('#authorize').show();
      $('#logoff').hide();
      $('#download').hide();
    }
  });
</script>
<style>
  header {
    background-color: #666;
    padding: 5px;
    height: 50px;
    text-align: center;
    font-size: 15px;
    color: white;
  }

  #logoff {
    float: right
  }

  #logo {
    float: left
  }
</style>

<header>
  <div class="dropdown">
    <button id="listDrive" onclick="listDrive()" class="btn btn-primary">
      <ion-icon name="list-outline"></ion-icon>
    </button>
    <button id="download" onclick="download()" class="btn btn-primary">
      <ion-icon name="cloud-download-outline"></ion-icon>
    </button>
    <button id="authorize" onclick="authorize()" class="btn btn-primary">
      <ion-icon name="logo-google"></ion-icon>Logar no Google
    </button>
    <button id="logoff" class="btn btn-secondary" data-bs-toggle="dropdown" aria-expanded="false">
      <ion-icon name="person-circle-outline"></ion-icon>
    </button>
    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
      <li><a class="dropdown-item" href="#">Cadastro</a></li>
      <li><a class="dropdown-item" href="#">Preferencias</a></li>
      <li><a class="dropdown-item" onclick="logoff()">Logoff</a></li>
    </ul>
  </div>
</header>